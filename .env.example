NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
CLERK_SECRET_KEY=sk_test_replace_me
# Comma-separated allowed website origins. Native apps do not send an Origin header.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: grant the admin role after this primary Clerk email is verified.
ADMIN_EMAIL=
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=Go-Shopper <applications@your-verified-domain.example>
APP_DOWNLOAD_URL=https://your-app-download-page.example.com
# Checkout amounts are integer kobo. Delivery and service fees default to 0 until configured.
MINIMUM_STORE_ORDER_KOBO=900000
CHECKOUT_DELIVERY_FEE_KOBO=0
CHECKOUT_SERVICE_FEE_KOBO=0
# Unpaid orders reserve stock for this many minutes; the worker releases expired reservations.
ORDER_RESERVATION_TTL_MINUTES=15
ORDER_RESERVATION_SWEEP_SECONDS=60
